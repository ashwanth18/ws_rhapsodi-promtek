# Copy to fleet-console.env (gitignored locally) or export before compose up.
#
# Shared bearer token for the Fleet Console API / UI (optional on private Tailnet).
FLEET_API_TOKEN=

# CI-only token for POST /api/releases/report (GitHub Actions secret CI_REPORT_TOKEN).
# Falls back to FLEET_API_TOKEN if unset.
CI_REPORT_TOKEN=

# Public URL agents and CI use to reach this console (Tailscale MagicDNS ok).
FLEET_CONSOLE_URL=http://jetson:8090

# Where the monorepo lives on the Jetson (mounted read-only into the container).
REPO_ROOT=/home/ashwanth/ws_rhapsodi-promtek-dev

PROMETHEUS_URL=http://127.0.0.1:9091
GRAFANA_PI_OVERVIEW_URL=http://127.0.0.1:3001/d/pi-overview/rhapsodi-pi-overview

IMAGE_REGISTRY=iserenity/rhapsodi-promtek

# Optional if host `tailscale status` is unavailable inside the container:
# TAILSCALE_API_KEY=
# TAILNET=example.ts.net

# GitHub token for branch listing + workflow_dispatch (Actions: write).
# Prefer a fine-grained PAT with Contents: Read + Actions: Write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=ashwanth18/ws_rhapsodi-promtek
