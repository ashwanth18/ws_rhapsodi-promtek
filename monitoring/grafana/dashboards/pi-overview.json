      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Last scrape age",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 0
      },
      "id": 7,
      "targets": [
        {
          "expr": "time() - timestamp(up{job=\"node\", instance=\"$instance\"})",
          "refId": "A"
