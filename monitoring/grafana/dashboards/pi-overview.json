      "id": 6,
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds{instance=\"$instance\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
