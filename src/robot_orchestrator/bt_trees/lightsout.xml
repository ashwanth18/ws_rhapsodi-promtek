<root BTCPP_format="4" main_tree_to_execute="LightsOut">
  <BehaviorTree ID="LightsOut">
    <Sequence name="LightsOutFlow">
      <WaitSeconds seconds="0.5"/>
      <VerifyCellLayout/>
      <Repeat num_cycles="{lightsout_episodes}">
        <Fallback name="EpisodeOrStop">
          <Precondition if="lightsout_stop_requested" else="FAILURE">
            <AlwaysSuccess/>
          </Precondition>
          <Sequence name="LightsOutEpisode">
            <EpisodeMarker/>
            <PhaseMarker phase="scoop_start"/>
            <WeightFresh max_age_s="2.0"/>
            <CaptureBaseline/>
            <MoveTo name="MoveToContainer" target_name="{lightsout_container_name}" use_cartesian="false"/>
            <Precondition if="enable_scoop" else="SUCCESS">
              <ExecuteScoop continuous="true" timeout_s="120.0"/>
            </Precondition>
            <PhaseMarker phase="scoop_end"/>
            <WaitSeconds seconds="3.0"/>
            <ForceSuccess>
              <MeasureScoopedMass/>
            </ForceSuccess>
            <SampleTargetWeight/>
            <PhaseMarker phase="pour_start"/>
            <MoveTo name="MoveToPour" target_name="{lightsout_pour_target}" use_cartesian="false"/>
            <ForceSuccess>
              <PourToTarget target_weight="{lightsout_target_weight_g}"
                            tolerance="{lightsout_tolerance_g}"
                            max_time_s="30"/>
            </ForceSuccess>
            <PhaseMarker phase="pour_end"/>
            <RecordPourOutcome/>
            <WaitSeconds seconds="1.0"/>
            <!-- Close MCAP before purge so residue dump does not pollute episode metrics. -->
            <EpisodeEndMarker/>
            <ForceSuccess>
              <Precondition if="lightsout_purge_enabled" else="SUCCESS">
                <Sequence name="PurgeScoop">
                  <Precondition if="lightsout_purge_pose_enabled" else="SUCCESS">
                    <MoveTo name="MoveToPurge" target_name="{lightsout_purge_target}" use_cartesian="false"/>
                  </Precondition>
                  <!-- Prefer centred tilt (lift+pre-shift+incline); fall back to joint_5-only. -->
                  <Fallback name="TiltPurge">
                    <Precondition if="lightsout_purge_hold_tcp" else="FAILURE">
                      <TiltAboutTcp name="TiltPurgeHoldTcp"
                                    degrees="{lightsout_purge_incline_deg}"/>
                    </Precondition>
                    <SetIncline degrees="{lightsout_purge_incline_deg}"/>
                  </Fallback>
                  <WaitSeconds seconds="1.0"/>
                  <Vibrate value="{lightsout_purge_vibration}" duration_s="{lightsout_purge_duration_s}"/>
                  <!-- Always untilt via joint incline; MoveBackToContainer follows. -->
                  <SetIncline degrees="0.0"/>
                  <WaitSeconds seconds="0.5"/>
                </Sequence>
              </Precondition>
            </ForceSuccess>
            <MoveTo name="MoveBackToContainer" target_name="{lightsout_container_name}" use_cartesian="false"/>
            <EvaluateStopCondition/>
          </Sequence>
        </Fallback>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>
