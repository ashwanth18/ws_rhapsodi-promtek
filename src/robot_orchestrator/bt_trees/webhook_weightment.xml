<root BTCPP_format="4" main_tree_to_execute="WebhookWeightment">
  <BehaviorTree ID="WebhookWeightment">
    <Sequence name="WebhookWeightmentFlow">
      <WaitSeconds seconds="0.5"/>
      <VerifyCellLayout/>
      <WeightFresh max_age_s="2.0"/>
      <CaptureBaseline/>
      <RetryIfNeedRescoop num_attempts="-1"
                           flag_key="pour_need_rescoop"
                           attempt_index="{rescoop_attempt_index}">
        <Sequence name="RescoopCycle">
          <!-- <MoveTo name="MoveToWebhookPickup"
                  target_name="{webhook_pickup_target_name}"
                  use_cartesian="false"
                  velocity_scaling="0.20"
                  acceleration_scaling="0.20" /> -->
          <PhaseMarker phase="transport_start"/>
          <MoveTo name="MoveToScoopingContainer"
                  target_name="MoveToScoopingContainer"
                  use_cartesian="false"
                  velocity_scaling="0.70"
                  acceleration_scaling="0.70" />
          <PhaseMarker phase="transport_end"/>
          <WaitSeconds seconds="1.0"/>
          <PhaseMarker phase="scoop_start"/>
          <ComputeScoopOffset attempt_index="{rescoop_attempt_index}"
                              base_offset_y="0.0"
                              step_y="-0.06"
                              min_offset_y="-0.18"
                              max_offset_y="0.0"
                              pattern_offset_y="{scoop_pattern_offset_y}"/>
          <ExecuteScoop continuous="true"
                        timeout_s="120.0"
                        pattern_offset_y="{scoop_pattern_offset_y}"/>
          <PhaseMarker phase="scoop_end"/>
          <WaitSeconds seconds="1.0"/>

          <PhaseMarker phase="transport_start"/>
          <!-- <MoveTo name="MoveToWebhookWeigh"
                  target_name="{webhook_weigh_target_name}"
                  constrain_upright="true"
                  use_cartesian="false"
                  velocity_scaling="0.15"
                  acceleration_scaling="0.15" /> -->
          <MoveTo name="MoveToWeighingContainer"
                  target_name="MoveToWeighingContainer"
                  use_cartesian="false"
                  velocity_scaling="0.70"
                  acceleration_scaling="0.70" />
          <PhaseMarker phase="transport_end"/>
          <WaitSeconds seconds="2.5"/>
          <ForceSuccess>
            <ComputeRemaining batch_target="{webhook_target_weight_g}"
                              tolerance="{webhook_tolerance_g}"
                              remaining="{remaining_weight}"/>
          </ForceSuccess>
          <LogRemainingWeight remaining_weight="{remaining_weight}"
                              tolerance="{webhook_tolerance_g}"/>
          <Fallback name="MaybePourRemaining">
            <CheckRemaining tolerance="{webhook_tolerance_g}"/>
            <Sequence name="PourRemainingMass">
              <!-- <MoveTo name="MoveToPrePourTiltback"
                      target_name="PrePourTiltbackAtWeighingContainer"
                      use_cartesian="false"
                      planning_pipeline="stomp"
                      velocity_scaling="0.15"
                       acceleration_scaling="0.15" /> -->
              <PhaseMarker phase="pre_pour"/> 
              <!-- Approach upright, then MoveIt to a taught TCP-fixed ~32° tilt.
                   Dosing is vibration-only (COARSE_TILT_DEG=0); joint incline
                   would swing the scoop lip out of the vessel. -->
              <MoveTo name="MoveToPourStartAtWeighingContainer"
                      target_name="PourStartAtWeighingContainer"
                      use_cartesian="false"
                      planning_pipeline="stomp"
                      velocity_scaling="0.70"
                      acceleration_scaling="0.70" />
              <MoveTo name="MoveToPourTiltAtWeighingContainer"
                      target_name="PourTiltAtWeighingContainer"
                      use_cartesian="false"
                      planning_pipeline="stomp"
                      velocity_scaling="0.70"
                      acceleration_scaling="0.70" />
              <PhaseMarker phase="pour_start"/>
              <PourToTarget target_weight="{remaining_weight}"
                            tolerance="{webhook_tolerance_g}"
                            max_time_s="30"/>
              <PhaseMarker phase="pour_end"/>
              <ForceSuccess>
                <Sequence name="RecoverFromPourSequence">
                  <!-- Untilt in place (same TCP as PourStart), then lift. -->
                  <MoveTo name="MoveToPostPourTiltback"
                          target_name="PostPourTiltbackAtWeighingContainer"
                          use_cartesian="false"
                          planning_pipeline="stomp"
                          velocity_scaling="0.70"
                          acceleration_scaling="0.70" />
                  <PhaseMarker phase="post_pour"/>
                  <MoveTo name="MoveToPourDone"
                          target_name="PourDoneAtWeighingContainer"
                          use_cartesian="false"
                          planning_pipeline="stomp"
                          velocity_scaling="0.70"
                          acceleration_scaling="0.70" />
                  <PhaseMarker phase="pour_done"/>
                </Sequence>
              </ForceSuccess>
            </Sequence>
          </Fallback>
          <WaitSeconds seconds="1.0"/>
        </Sequence>
      </RetryIfNeedRescoop>

      <PhaseMarker phase="transport_start"/>
      <!-- <MoveTo name="RecoverFromPourBeforeReturnHome"
              target_name="RecoverFromPourAtWeighingContainer"
              constrain_upright="false"
              use_cartesian="false"
              velocity_scaling="0.20"
              acceleration_scaling="0.20" />
      <MoveTo name="RecoverUprightBeforeReturnHome"
              target_name="MoveToWeighingContainer"
              constrain_upright="true"
              use_cartesian="false"
              velocity_scaling="0.20"
              acceleration_scaling="0.20" /> -->
      <!-- 
      <MoveTo name="ReturnWebhookHome"
              target_name="{webhook_return_target_name}"
              constrain_upright="true"
              use_cartesian="false"
              velocity_scaling="0.20"
              acceleration_scaling="0.20" /> -->
      <MoveTo name="ReturnToScoopingContainer"
              target_name="MoveToScoopingContainer"
              use_cartesian="false"
              velocity_scaling="0.70"
              acceleration_scaling="0.70" />
      <PhaseMarker phase="transport_end"/>
    </Sequence>
  </BehaviorTree>
</root>
