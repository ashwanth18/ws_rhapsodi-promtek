# Laptop testing env for docker-compose.robot-prod.yml

# Core ROS network settings
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Physical robot connection
ROBOT_IP=169.254.200.200

# Scale serial device
SCALE_DEVICE=/dev/ttyUSB0
SCALE_BAUD=9600

# micro-ROS / Teensy serial device
MICRO_ROS_DEVICE=/dev/ttyACM0

# Runtime behavior
ROBOT_RUNNING_TIMEOUT_SECONDS=300
POST_LIFT_VIBRATION_ENABLED=true
POST_LIFT_VIBRATION_DURATION_S=5.0
POST_LIFT_VIBRATION_INTENSITY=0.60
POST_LIFT_VIBRATION_PUBLISH_RATE_HZ=10.0
POST_LIFT_VIBRATION_SETTLE_S=1.5

# Images (pin with IMAGE_TAG=<git-sha> from buildx_push_images.sh)
IMAGE_TAG=
IMAGE_REGISTRY=iserenity/rhapsodi-promtek
ROS_PROD_IMAGE=iserenity/rhapsodi-promtek:ros-prod
BACKEND_IMAGE=iserenity/rhapsodi-promtek:backend
PROCESSING_IMAGE=iserenity/rhapsodi-promtek:processing
WEBHOOK_IMAGE=iserenity/rhapsodi-promtek:webhook
DASHBOARD_IMAGE=iserenity/rhapsodi-promtek:dashboard
MICRO_ROS_AGENT_IMAGE=microros/micro-ros-agent:jazzy
CONDOR_AGENT_IMAGE=iserenity/rhapsodi-promtek:condor-agent
DASHBOARD_PORT=8080

# Host path mapping
WORKSPACE_ROOT=/home/ashwanth/ws_rhapsodi-promtek-dev

# Backend / dashboard access
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://169.254.200.201:8080
WEIGHMENT_URL=http://host.docker.internal:5002/batch/weighment
BATCH_END_URL=http://host.docker.internal:5002/batch/end
TIMESERIES_URL=http://host.docker.internal:5002/timeseries
ROBOT_LOCATION_TARGETS_JSON=
CONDOR_AGENT_RHAPSODI_URL=http://webhook_service:5000
CONDOR_AGENT_PORT=5002
CONDOR_AGENT_LOG_DIR=/data/condor-agent/logs/{Service.Name}

# Robot config overrides
POSES_YAML=/root/.ros/scooping_controller/poses_real.yaml
TARGETS_YAML=/ws/install/share/robot_moveit/targets.yaml
CONTAINER_SCENE_YAML=/ws/install/share/scooping_controller/config/container_scene_real.yaml
