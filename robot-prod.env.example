# Copy this file per robot, for example:
#   cp robot-prod.env.example robot-prod.env
# Then edit the values for that Pi / robot and run:
#   docker compose --env-file robot-prod.env -f docker-compose.robot-prod.yml up -d
# Laptop / x86 (compose/devices/x86.yml) MUST pass --project-directory:
#   make laptop-up
#   # or:
#   docker compose --project-directory . --env-file robot-prod.laptop.env \
#     -f compose/devices/x86.yml up -d
#
# Robot/device IDENTITY (robot_id, site_id, robot_type, ingestion/processing
# URLs) now lives in config/device.yaml, not in this file — see
# config/device.yaml.example. This file stays scoped to network/hardware/
# image settings for docker compose itself.

# Core ROS network settings
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Physical robot connection
# Niryo Pi link-local: 169.254.200.200
# Schneider Lexium Cobot (laptop cell): 192.168.88.82 — see docs/lexium-laptop-networking.md
# Lexium uses TCP 10001 (commands) + 10000 (feedback), not JAKA SDK port 10004.
ROBOT_IP=169.254.200.200

# FollowJointTrajectory action for pouring_controller incline moves.
# Niryo (default): /niryo_robot_follow_joint_trajectory_controller/follow_joint_trajectory
# JAKA/Lexium:     /jaka_zu5_controller/follow_joint_trajectory
TRAJ_ACTION_SERVER=/niryo_robot_follow_joint_trajectory_controller/follow_joint_trajectory

# Scale serial device
SCALE_DEVICE=/dev/ttyUSB0
SCALE_BAUD=9600

# micro-ROS / Teensy serial device
MICRO_ROS_DEVICE=/dev/ttyACM0

# Runtime behavior
ROBOT_RUNNING_TIMEOUT_SECONDS=300
POST_LIFT_VIBRATION_ENABLED=true
POST_LIFT_VIBRATION_DURATION_S=5.0
POST_LIFT_VIBRATION_INTENSITY=0.60
POST_LIFT_VIBRATION_PUBLISH_RATE_HZ=10.0

# Lights-out end-of-episode scoop residue purge (tilt via /incline_control + vibrate).
# Runs after EpisodeEndMarker so residue dump does not pollute episode metrics.
# Empty LIGHTSOUT_PURGE_TARGET = purge in place at the pour pose (no extra MoveTo).
# Set LIGHTSOUT_PURGE_TARGET to a taught MoveTo name (e.g. lightsoutPourDump) later if needed.
LIGHTSOUT_PURGE_ENABLED=true
LIGHTSOUT_PURGE_INCLINE_DEG=20.0
LIGHTSOUT_PURGE_VIBRATION=0.8
LIGHTSOUT_PURGE_DURATION_S=3.0
LIGHTSOUT_PURGE_TARGET=

# Image pinning
# Leave IMAGE_TAG empty to float on role tags (:ros-prod, :backend, ...).
# Set IMAGE_TAG to a git short sha from `scripts/buildx_push_images.sh` to pin
# every app image to that build (rollback = set previous sha and redeploy).
IMAGE_TAG=
IMAGE_REGISTRY=iserenity/rhapsodi-promtek
# Derived image refs (Ansible deploy rewrites these when IMAGE_TAG is set).
ROS_PROD_IMAGE=iserenity/rhapsodi-promtek:ros-prod
BACKEND_IMAGE=iserenity/rhapsodi-promtek:backend
PROCESSING_IMAGE=iserenity/rhapsodi-promtek:processing
WEBHOOK_IMAGE=iserenity/rhapsodi-promtek:webhook
DASHBOARD_IMAGE=iserenity/rhapsodi-promtek:dashboard
CONDOR_AGENT_IMAGE=iserenity/rhapsodi-promtek:condor-agent
INGESTION_IMAGE=iserenity/rhapsodi-promtek:ingestion
MICRO_ROS_AGENT_IMAGE=microros/micro-ros-agent:jazzy
DASHBOARD_PORT=8080
INGESTION_PORT=8011
# Where central-ingestion-service stores Tier-0/Tier-1 blobs (inside the
# ./data volume mount). Separate from DATA_OUTPUT_ROOT on the Pi recorder.
OBJECT_STORE_ROOT=/data/ingested

# Postgres (templated by Ansible from vault; default is for local/dev only)
POSTGRES_PASSWORD=postgres

# Optional workspace/data path mapping for processing
WORKSPACE_ROOT=/opt/rhapsodi/ws_rhapsodi-promtek

# Optional backend/app overrides
# Default '*': reflect any http(s) Origin so the dashboard works via localhost,
# 127.0.0.1, LAN, or Tailscale MagicDNS. Restrict only if you need an allow-list
# (include both localhost and 127.0.0.1 variants of each port you use).
CORS_ORIGINS=*
WEIGHMENT_URL=http://host.docker.internal:5002/batch/weighment
BATCH_END_URL=http://host.docker.internal:5002/batch/end
TIMESERIES_URL=http://host.docker.internal:5002/timeseries
# Condor gateway IDs for /timeseries (must match agent appsettings; not RHAPSODI_1).
TIMESERIES_ORGANISATION_ID=6647A41A-8FEB-4082-86F4-3D14964161AD
TIMESERIES_SITE_ID=76454DA2-683C-4706-A88E-4E2FC6773685
TIMESERIES_USER_ID=15de0997-1508-4f2e-91de-14745f295d9e
ROBOT_LOCATION_TARGETS_JSON=
CONDOR_AGENT_RHAPSODI_URL=http://webhook_service:5000
CONDOR_AGENT_PORT=5002
CONDOR_AGENT_LOG_DIR=/data/condor-agent/logs/{Service.Name}

# mes-generic (Phase 6): inbound adapter + outbound sink. Unused when mode is
# mes-condor (Promtek still posts to webhook_service). See docs/MODES.md.
# MES_GENERIC_INBOUND_ADAPTER=condor|generic_json  (default: condor)
MES_GENERIC_INBOUND_ADAPTER=generic_json
# JSON object: internal weightment field → dotted JSON path in the request body.
MES_GENERIC_FIELD_MAP_JSON={"event_id":"id","batch_id":"batch","target_weight_kg":"target_kg","ingredient_id":"ingredient","site_id":"site"}
# Optional: path to a list of line objects (each becomes one weightment).
# MES_GENERIC_LINES_PATH=lines
# Outbound: condor (default, CondorMesClient) or null (NullMesClient).
MES_GENERIC_SINK=condor

# Runtime profile (set by Ansible / Fleet Console from config/profiles.yaml)
# PROFILE_ID selects a named behavior + layout; independent of IMAGE_TAG.
PROFILE_ID=prod-niryo
BT_TREE=/ws/install/share/robot_orchestrator/bt_trees/webhook_weightment.xml
# Single recorder root; per-mode run folders go under {DATA_OUTPUT_ROOT}/{mode}/
DATA_OUTPUT_ROOT=/data/runs
# Hardware form-factor (pi5 | jetson | x86). Sim refuses when this is pi5.
DEVICE_CLASS=pi5
# Sim is laptop-only (docker-compose.sim.yml). Always 0 on robot-prod / Pi5.
SIM_ALLOWED=0
ENVIRONMENT=real
# Versioned layout files mounted by the ROS stack. DEFAULT_LAYOUT_ID is optional;
# runtime mode changes resolve mode_layouts in config/profiles.yaml.
CELL_LAYOUTS_DIR=/ws/config/layouts
# When set, scooping_stack boots with layout_id:=… (seeds poses/targets/scene
# without calling /cell_layout/apply preflight). Use the mode layout for this
# cell, e.g. lightsout-single-vessel for lights-out-only Pis.
DEFAULT_LAYOUT_ID=
# Per-robot profiles emitted into the deploy bundle (config/robots/<type>.yaml).
# Launch resolves the active robot from device.yaml robot_type unless ROBOT_TYPE
# is set explicitly.
ROBOT_PROFILES_DIR=/ws/config/robots
# Optional override; leave empty so scooping_real.launch.py reads device.yaml.
ROBOT_TYPE=
# Device identity file inside the container (mounted from ./config).
RHAPSODI_DEVICE_CONFIG=/ws/config/device.yaml

# ---------------------------------------------------------------------------
# Laptop / Lexium Cobot cell (compose/devices/x86.yml)
# ---------------------------------------------------------------------------
# Copy this file to robot-prod.laptop.env (gitignored) and set:
#
#   DEVICE_CLASS=x86
#   ENVIRONMENT=real
#   SIM_ALLOWED=0
#   PROFILE_ID=prod-jaka
#   ROBOT_IP=192.168.88.82
#   TRAJ_ACTION_SERVER=/jaka_zu5_controller/follow_joint_trajectory
#   RHAPSODI_DEVICE_CONFIG=/ws/config/device.jaka-laptop.yaml
#   ROS_PROD_IMAGE=iserenity/rhapsodi-promtek:ros-prod-lexium
#   # Scale needs its own USB UART; ESP micro-ROS typically owns the CP2102.
#   # SCALE_DEVICE=/dev/ttyUSB1
#   MICRO_ROS_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
#   COMPOSE_FILE=compose/devices/x86.yml
#   # Leave DEFAULT_LAYOUT_ID empty until dual-container has targets_by_robot.jaka
#
# Build the local image first (includes lexium_driver / lexium_msgs):
#   make ros-image-local
#
# Then (always --project-directory; never omit it for devices/*.yml):
#   make laptop-up
#   make lexium-session   # host RViz + Lexium Safety panel
#   make scooping-logs    # MoveIt/MTC logs from scooping_stack
#
# Networking: docs/lexium-laptop-networking.md
# Compose paths: compose/README.md ("Project directory")
# ---------------------------------------------------------------------------
# Backend -> local ROS adapter endpoint used to apply a mode's layout.
ROBOT_LAYOUT_ADAPTER_URL=http://host.docker.internal:8010/apply_cell_layout
# Optional override for config/recording_profiles.yaml (pour/scoop/camera
# topics). Default matches the ./config -> /ws/config:ro bind mount.
RHAPSODI_RECORDING_PROFILES=/ws/config/recording_profiles.yaml
COMPOSE_FILE=docker-compose.robot-prod.yml

# Central Loki push URL for Promtail (monitoring/exporters). Default uses
# Tailscale MagicDNS for the Jetson monitoring host. On the Jetson itself use
# http://127.0.0.1:3100/loki/api/v1/push.
LOKI_URL=http://jetson:3100/loki/api/v1/push
# Must match Tailscale / Fleet Console device id (Prometheus instance label).
# If unset, Promtail tries Tailscale DNSName, then /etc/hostname.
HOST_LABEL=

# Optional robot config overrides (paths may point at /ws/config/profiles/...)
# Leave POSES_YAML empty so scooping_marker_server derives
# poses_real_<layout_id>.yaml under /root/.ros/scooping_controller/.
POSES_YAML=
POSES_ENV=real
TARGETS_YAML=/ws/install/share/robot_moveit/targets.yaml
CONTAINER_SCENE_YAML=/ws/install/share/scooping_controller/config/container_scene_real.yaml
